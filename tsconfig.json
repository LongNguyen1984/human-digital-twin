{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@hdt/core": ["packages/core/src/index.ts"],
      "@hdt/plugin-*": ["plugins/*/src/index.ts"]
    }
  },
  "include": ["packages/*/src", "plugins/*/src", "apps/*/src"],
  "exclude": ["plugins/_template"]
}
